rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Custom functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }
    function isCompanyAdmin() {
      return isAuthenticated() && request.auth.token.role == 'company_admin';
    }
    function isSocietyAdmin(societyId) {
      return isAuthenticated() && request.auth.token.role == 'society_admin' && request.auth.token.societyId == societyId;
    }
    function isGuardSupervisor(societyId) {
      return isAuthenticated() && request.auth.token.role == 'guard_supervisor' && request.auth.token.societyId == societyId;
    }
    function isGuard(societyId) {
      return isAuthenticated() && request.auth.token.role == 'guard' && request.auth.token.societyId == societyId;
    }
    function isResident(societyId) {
      return isAuthenticated() && request.auth.token.role == 'resident' && request.auth.token.societyId == societyId;
    }
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || isSelf(userId) || (isAuthenticated() && resource.data.societyId == request.auth.token.societyId);
      allow write: if isSuperAdmin() || isSelf(userId);
    }

    match /societies/{societyId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isCompanyAdmin();
      
      match /towers/{towerId} {
        allow read: if isAuthenticated() && request.auth.token.societyId == societyId;
        allow write: if isSocietyAdmin(societyId);
      }
      
      match /flats/{flatId} {
        allow read: if isAuthenticated() && request.auth.token.societyId == societyId;
        allow write: if isSocietyAdmin(societyId);
      }
      
      match /visitors/{visitorId} {
        allow read: if isAuthenticated() && request.auth.token.societyId == societyId;
        // Guards can create, update (entry/exit). Residents can update (approve/reject).
        allow create: if isGuard(societyId) || isGuardSupervisor(societyId);
        allow update: if isGuard(societyId) || isGuardSupervisor(societyId) || isResident(societyId) || isSocietyAdmin(societyId);
      }

      match /attendance/{attendanceId} {
        allow read: if isSocietyAdmin(societyId) || isGuardSupervisor(societyId) || isGuard(societyId);
        allow create, update: if isGuard(societyId) || isGuardSupervisor(societyId);
      }

      match /incidents/{incidentId} {
        allow read: if isAuthenticated() && request.auth.token.societyId == societyId;
        allow create: if isAuthenticated() && request.auth.token.societyId == societyId;
        allow update: if isSocietyAdmin(societyId) || isGuardSupervisor(societyId);
      }

      match /patrols/{patrolId} {
        allow read: if isSocietyAdmin(societyId) || isGuardSupervisor(societyId);
        allow create, update: if isGuard(societyId) || isGuardSupervisor(societyId);
      }

      match /parcels/{parcelId} {
        allow read: if isAuthenticated() && request.auth.token.societyId == societyId;
        allow create: if isGuard(societyId) || isGuardSupervisor(societyId);
        allow update: if isGuard(societyId) || isGuardSupervisor(societyId) || isResident(societyId);
      }
    }
  }
}
