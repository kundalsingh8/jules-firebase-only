rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // By default, do not allow access
      allow read, write: if false;
    }

    match /profile_pictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /visitor_photos/{societyId}/{visitorId} {
      allow read: if request.auth != null && request.auth.token.societyId == societyId;
      allow create: if request.auth != null && (request.auth.token.role == 'guard' || request.auth.token.role == 'guard_supervisor') && request.auth.token.societyId == societyId;
    }

    match /incident_media/{societyId}/{incidentId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.societyId == societyId;
      allow create: if request.auth != null && request.auth.token.societyId == societyId;
    }

    // Protect PII like Aadhaar cards
    match /id_documents/{userId}/{fileName} {
      allow read: if request.auth.uid == userId || request.auth.token.role == 'super_admin' || request.auth.token.role == 'company_admin';
      allow write: if request.auth.uid == userId;
    }
  }
}
